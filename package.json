{
    "name": "actual-moneymoney",
    "version": "2.20.0-fork.1",
    "description": "An importer for syncing MoneyMoney accounts and transactions to Actual.",
    "exports": "./index.js",
    "scripts": {
        "build": "npx tsc",
        "start": "node dist/index.js",
        "test": "npm run test:cli",
        "test:cli": "npm run build && node --test test/cli/**/*.test.mjs",
        "release:dry-run": "semantic-release --dry-run",
        "lint:eslint": "eslint src",
        "lint:prettier": "prettier --check 'src/**/*.ts'",
        "lint:fix": "eslint src --fix && prettier --write 'src/**/*.ts'",
        "prepare": "husky"
    },
    "type": "module",
    "keywords": [
        "actual",
        "moneymoney",
        "finance",
        "budget",
        "sync",
        "import",
        "importer"
    ],
    "bin": {
        "actual-monmon": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "author": "NikxDa",
    "license": "MIT",
    "dependencies": {
        "@actual-app/api": "^26.2.0",
        "chalk": "^5.6.2",
        "date-fns": "^4.1.0",
        "moneymoney": "^1.2.1",
        "node-fetch": "^3.3.2",
        "openai": "^6.22.0",
        "string-width": "^8.1.1",
        "toml": "^3.0.0",
        "yargs": "^18.0.0",
        "zod": "^4.3.6"
    },
    "node": ">=25",
    "devDependencies": {
        "@commitlint/cli": "^20.4.1",
        "@commitlint/config-conventional": "^20.4.1",
        "@eslint/js": "^9.39.2",
        "@types/yargs": "^17.0.35",
        "eslint": "^9.39.2",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "semantic-release": "^25.0.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
