{
    "name": "actual-moneymoney-importer",
    "version": "2.20.0",
    "description": "An importer for syncing MoneyMoney accounts and transactions to Actual.",
    "packageManager": "npm@11.12.1",
    "scripts": {
        "build": "tsc",
        "generate:example-config": "node scripts/generate-example-config.js",
        "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && npm run generate:example-config",
        "start": "node dist/index.js",
        "test": "npm run build && node --test \"test/cli/**/*.test.mjs\" \"test/unit/**/*.test.mjs\"",
        "test:cli": "npm run build && node --test \"test/cli/**/*.test.mjs\"",
        "test:unit": "npm run build && node --test \"test/unit/**/*.test.mjs\"",
        "test:coverage": "npm run build && node --test --experimental-test-coverage \"test/cli/**/*.test.mjs\" \"test/unit/**/*.test.mjs\"",
        "test:apple-intelligence": "npm run build && node --test test/unit/apple-intelligence.test.mjs",
        "lint:eslint": "eslint src test eslint.config.mjs commitlint.config.js",
        "lint:prettier": "prettier --check 'src/**/*.ts' 'test/**/*.mjs' '*.md' '.github/**/*.md' '.github/**/*.yml' 'package.json' 'tsconfig.json' '.releaserc.json' 'eslint.config.mjs' 'commitlint.config.js'",
        "lint:markdownlint": "markdownlint-cli2 '*.md' '.github/**/*.md'",
        "lint:fix": "eslint src test eslint.config.mjs commitlint.config.js --fix && prettier --write 'src/**/*.ts' 'test/**/*.mjs' '*.md' '.github/**/*.md' '.github/**/*.yml' 'package.json' 'tsconfig.json' '.releaserc.json' 'eslint.config.mjs' 'commitlint.config.js' && markdownlint-cli2 --fix '*.md' '.github/**/*.md'",
        "prepare": "husky"
    },
    "type": "module",
    "keywords": [
        "actual",
        "moneymoney",
        "finance",
        "budget",
        "sync",
        "import",
        "importer"
    ],
    "bin": {
        "actual-mmi": "dist/index.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "assets/config.example.toml"
    ],
    "author": "1cu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/1cu/actual-moneymoney-importer.git"
    },
    "homepage": "https://github.com/1cu/actual-moneymoney-importer#readme",
    "bugs": {
        "url": "https://github.com/1cu/actual-moneymoney-importer/issues"
    },
    "dependencies": {
        "@actual-app/api": "^26.7.0",
        "@actual-app/core": "^26.7.0",
        "chalk": "^5.6.2",
        "date-fns": "^4.4.0",
        "moneymoney": "^1.3.0",
        "openai": "^6.45.0",
        "string-width": "^8.2.1",
        "toml": "^4.1.2",
        "yargs": "^18.0.0",
        "zod": "^4.4.3"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.1.0",
        "@types/yargs": "^17.0.35",
        "eslint": "^10.6.0",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "markdownlint-cli2": "^0.23.0",
        "prettier": "^3.9.4",
        "semantic-release": "^25.0.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "test/**/*.mjs": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.md": [
            "prettier --write",
            "markdownlint-cli2 --fix"
        ],
        ".github/**/*.md": [
            "prettier --write",
            "markdownlint-cli2 --fix"
        ],
        ".github/**/*.yml": [
            "prettier --write"
        ],
        "package.json": [
            "prettier --write"
        ],
        "tsconfig.json": [
            "prettier --write"
        ],
        ".releaserc.json": [
            "prettier --write"
        ],
        "eslint.config.mjs": [
            "eslint --fix",
            "prettier --write"
        ],
        "commitlint.config.js": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "optionalDependencies": {
        "tsfm-sdk": "^0.3.1"
    },
    "overrides": {
        "js-yaml": "4.2.0",
        "markdown-it": "14.2.0"
    }
}
