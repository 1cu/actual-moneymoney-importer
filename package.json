{
    "name": "actual-moneymoney-importer",
    "version": "2.20.0-fork.1",
    "description": "An importer for syncing MoneyMoney accounts and transactions to Actual.",
    "scripts": {
        "build": "npx tsc",
        "start": "node dist/index.js",
        "test": "npm run test:cli",
        "test:cli": "npm run build && node --test test/cli/**/*.test.mjs",
        "lint:eslint": "eslint src",
        "lint:prettier": "prettier --check 'src/**/*.ts'",
        "lint:fix": "eslint src --fix && prettier --write 'src/**/*.ts'",
        "prepare": "husky"
    },
    "type": "module",
    "keywords": [
        "actual",
        "moneymoney",
        "finance",
        "budget",
        "sync",
        "import",
        "importer"
    ],
    "bin": {
        "actual-mmi": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "author": "1cu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/1cu/actual-moneymoney-importer.git"
    },
    "homepage": "https://github.com/1cu/actual-moneymoney-importer#readme",
    "bugs": {
        "url": "https://github.com/1cu/actual-moneymoney-importer/issues"
    },
    "dependencies": {
        "@actual-app/api": "^26.5.0",
        "chalk": "^5.6.2",
        "date-fns": "^4.1.0",
        "moneymoney": "^1.3.0",
        "node-fetch": "^3.3.2",
        "openai": "^6.35.0",
        "string-width": "^8.2.1",
        "toml": "^4.1.1",
        "yargs": "^18.0.0",
        "zod": "^4.4.2"
    },
    "engines": {
        "node": ">=25"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^10.0.1",
        "@types/yargs": "^17.0.35",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "semantic-release": "^25.0.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
